#!/usr/bin/env bash
# Root orchestrates; yay builds and installs as the sudo-enabled daily account.
set -euo pipefail
[[ $EUID == 0 && -f /etc/arch-release ]] || { echo 'Run on installed Arch as root.' >&2; exit 1; }
base=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$base/ui.sh"
source "$base/aur.sh"
aur_init
revision=77eafb5fd43e2b377b2289864e5cc0298b9464f6
version=26.04.10.1-1
if [[ $(pacman -Q icaclient 2>/dev/null || true) != "icaclient $version" ]]; then
  # These dependencies are from the pinned .SRCINFO, not code sourced as root.
  run_progress 'Installing Citrix build tools and dependencies' bash "$base/install-packages" \
    base-devel alsa-lib curl gst-plugins-base-libs libc++ libc++abi libsecret \
    libvorbis libxaw libxml2-legacy libxp openssl speex
  build=$(aur_new_build citrix)
  run_progress 'Fetching Citrix recipe with yay' bash "$base/aur-user" "$daily" "$build" /usr/bin/yay -G icaclient
  # yay -G creates the package-name directory.
  aur_as_user mv "$build/icaclient" "$build/source"
  run_progress 'Selecting reviewed Citrix revision' bash "$base/aur-user" "$daily" "$build/source" git -C "$build/source" checkout --detach "$revision"
  [[ $(aur_as_user git -C "$build/source" rev-parse HEAD) == "$revision" ]] || exit 1
  # Keep the reviewed recipe and checksums, but select its VERSIONED vendor page.
  aur_as_user cp "$build/source/PKGBUILD" "$build/source/PKGBUILD.reviewed"
  install -m 0644 -o "$daily" -g "$(id -gn "$daily")" "$base/citrix-source.py" "$build/citrix-source.py"
  aur_as_user python3 "$build/citrix-source.py" "$build/source/PKGBUILD.reviewed" "$build/source/PKGBUILD"
  # The vendor normally supplies short-lived signed download URLs via the recipe.
  # If blocked, use an explicitly selected vendor archive and the SAME pinned checksum.
  if ! run_progress 'Downloading and checking Citrix source' bash "$base/aur-user" "$daily" "$build/source" bash -c 'cd "$1"; exec makepkg --verifysource --noconfirm' verify "$build/source"; then
    printf '%b\n' "Downloading or verifying Citrix failed. The preceding error is in the setup log: ${install_log:-terminal output}. This can be an HTTP error, missing link, network failure or checksum mismatch.\n\nFor the local fallback, open this exact version's page in your browser:\nhttps://www.citrix.com/downloads/workspace-app/legacy-workspace-app-for-linux/workspace-app-for-linux-2604-10.html\n\nChoose the Linux x86_64 TARBALL for 2604.10 (26.04.10.1), not the newer latest release. The existing SHA-256 check still applies." >&2
    archive=$(ui_input 'Citrix vendor archive' 'Full path to linuxx64-gcc-8-26.04.10.1.tar.gz:' "/home/${PORTHPEAN_DAILY_USER:-ryan}/Downloads/linuxx64-gcc-8-26.04.10.1.tar.gz") || exit 1
    [[ -f $archive ]] || { echo 'Archive does not exist.' >&2; exit 1; }
    expected=8c0a22cad4a4cda802cb5d3bb09b89779d20f68ba5e454b86485354c557356b5
    [[ $(sha256sum -- "$archive" | cut -d ' ' -f1) == "$expected" ]] || { echo 'Citrix archive checksum does not match the reviewed release.' >&2; exit 1; }
    install -m 0600 -o "$daily" -g "$(id -gn "$daily")" "$archive" "$build/source/icaclient-x64-26.04.10.1.tar.gz"
    aur_as_user python3 "$build/citrix-source.py" "$build/source/PKGBUILD.reviewed" "$build/source/PKGBUILD" --local
  fi
  # Let yay regenerate metadata for the patched recipe and install it through sudo pacman.
  aur_as_user rm -f "$build/source/.SRCINFO"
  aur_enable_install
  run_progress 'Installing Citrix Workspace with yay' bash "$base/aur-user" "$daily" "$build/source" \
    /usr/bin/yay -Bi --noconfirm --sudo /usr/bin/sudo --sudoflags=-n --sudoloop=false "$build/source"
  [[ $(pacman -Q icaclient) == "icaclient $version" ]] || exit 1
fi
# Vendor services are not enabled, and security/USB/app-protection components aren't added.
printf 'Citrix Workspace present. Packaging revision: %s\n' "$revision"
# Ensure private daily-client settings even when the package is already present.
# aur_init has already validated the selected daily account.
install -d -m 0700 -o "$daily" -g "$daily" "/home/$daily/.ICAClient" "/home/$daily/.ICAClient/cache"
for file in All_Regions Trusted_Region Unknown_Region canonicalization regions; do
  [[ -f /home/$daily/.ICAClient/$file.ini ]] || install -m 0600 -o "$daily" -g "$daily" "/opt/Citrix/ICAClient/config/$file.ini" "/home/$daily/.ICAClient/$file.ini"
done
