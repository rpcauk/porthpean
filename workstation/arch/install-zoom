#!/usr/bin/env bash
# Called by bootstrap with terminal output and a private log.
set -euo pipefail
umask 022
base=$(cd -- "$(dirname -- "$0")" && pwd)
source "$base/aur.sh"
aur_init
[[ $EUID == 0 && $(uname -m) == x86_64 ]] || { echo 'Zoom setup requires root on x86_64 Arch.' >&2; exit 1; }
pacman -Q icaclient >/dev/null
version=6.4.11-2
if [[ $(pacman -Q zoom-citrix-plugin-ms 2>/dev/null || true) != "zoom-citrix-plugin-ms $version" ]]; then
  # Official dependencies still use one package transaction at a time.
  bash "$base/install-packages" base-devel alsa-lib gtk3 libglvnd libpulse libx11 libxcb libxcomposite libxv libxkbcommon-x11 xcb-util-image xcb-util-keysyms xcb-util-renderutil xcb-util-wm krb5 gcc-libs
  build=$(aur_new_build zoom)
  install -m 0644 -o "$daily" -g "$(id -gn "$daily")" "$base/files/zoom/PKGBUILD" "$build/PKGBUILD"
  aur_install_local "$build"
  [[ $(pacman -Q zoom-citrix-plugin-ms) == "zoom-citrix-plugin-ms $version" ]] || exit 1
fi
# Always repair integration: upgrading Citrix can replace its module.ini.
ansible-playbook -i localhost, -c local "$base/zoom.yml"
echo 'Zoom plugin 6.4.11 (26350) configured. Close all Citrix sessions before reconnecting.'
