#!/usr/bin/env bash
set -euo pipefail
source /etc/os-release
[[ $ID == arch ]] || { echo 'Arch only'; exit 1; }
[[ $EUID == 0 ]] || { echo 'Run as root for complete checks'; exit 1; }
failed=0
config=/etc/porthpean-workstation.json
[[ -r $config ]] || { echo 'Missing completed bootstrap configuration'; exit 1; }
daily_user=$(jq -er '.daily_user' "$config")
mapfile -t agent_users < <(jq -r '.agent_users[]' "$config")
id root || failed=1
[[ $(stat -c '%a:%U' /root) == 700:root ]] || { echo 'FAIL: /root permissions'; failed=1; }
for path in / /etc /home /var /var/lib /var/lib/pacman /var/lib/pacman/local /var/lib/pacman/sync /var/cache /var/cache/pacman /var/cache/pacman/pkg /var/log /srv; do
  [[ $(stat -c '%a:%U' "$path") == 755:root ]] || { echo "FAIL: system directory permissions: $path"; failed=1; }
done
[[ $(stat -c '%a:%U' /var/tmp) == 1777:root ]] || { echo 'FAIL: /var/tmp permissions'; failed=1; }
runuser -u alpm -- test -x /var/cache/pacman/pkg || failed=1
runuser -u "$daily_user" -- pacman -Q >/dev/null || failed=1
runuser -u "$daily_user" -- pacman -Sl >/dev/null || failed=1
systemctl is-active dbus NetworkManager || failed=1
for account in "$daily_user" "${agent_users[@]}"; do
  id "$account" || failed=1
  [[ $(getent passwd "$account" | cut -d: -f7) == /bin/zsh ]] || { echo "FAIL: Zsh default for $account"; failed=1; }
  runuser -u "$account" -- test -x "/home/$account/.local/bin/pyre" || failed=1
  [[ $(stat -c '%a:%U' "/home/$account") == "700:$account" ]] || { echo "FAIL: home permissions: $account"; failed=1; }
done
for account in "$daily_user" "${agent_users[@]}"; do
  groups=$(id -nG "$account")
  forbidden="disk|docker|input"
  [[ $account == "$daily_user" ]] || forbidden="wheel|$forbidden"
  if [[ " $groups " =~ \ ($forbidden)\  ]]; then
    echo "FAIL: $account has a privileged group"; failed=1
  fi
done
for target in / /efi /home; do
  findmnt --mountpoint "$target" || failed=1
done
for file in /efi/EFI/Linux/arch-lts.efi /efi/EFI/Linux/arch-linux.efi; do
  [[ -s $file ]] || { echo "FAIL: missing $file"; failed=1; }
done
for path in /usr/share/backgrounds/porthpean/diogenes.jpg /etc/greetd/dark-plus.css /etc/greetd/regreet.toml /efi/EFI/refind/themes/porthpean/theme.conf /efi/EFI/Linux/arch-lts-recovery.efi; do
  [[ -s $path ]] || { echo "FAIL: missing theme file $path"; failed=1; }
done
runuser -u greeter -- test -r /etc/greetd/dark-plus.css || failed=1
visudo -c || failed=1
[[ ! -e /etc/sudoers.d/zz-porthpean-install ]] || { echo "FAIL: temporary installer sudo grant remains"; failed=1; }
[[ $(stat -c '%a:%U' /etc/sudoers.d/20-porthpean-daily) == 440:root ]] || failed=1
sudo -l -U "$daily_user" /usr/bin/pacman -Syu || failed=1
sudo -l -U "$daily_user" /usr/bin/systemctl reboot || failed=1
for account in "${agent_users[@]}"; do
  if sudo -l -U "$account" /usr/bin/pacman -Syu >/dev/null 2>&1; then
    echo "FAIL: $account has package-management sudo access"; failed=1
  fi
done
pacman -Q yay sudo zsh-fast-syntax-highlighting thunderbird hyprlock greetd-regreet plymouth icaclient zsh fzf tmux zoom-citrix-plugin-ms || failed=1
[[ $(head -n 1 /usr/lib/zoomvdi-universal-plugin/version.txt) == 6.4.11.26350 ]] || failed=1
[[ $(readlink /opt/Citrix/ICAClient/ZoomMedia.so) == /usr/lib/zoomvdi-universal-plugin/libZoomPlugin.so ]] || failed=1
systemctl is-enabled NetworkManager greetd nftables || failed=1
systemctl --failed --no-pager
nft --check --file /etc/nftables.conf || failed=1
niri validate -c "/home/$daily_user/.config/niri/config.kdl" || failed=1
printf '%s\n' 'Review failed units above, account/polkit permissions, live firewall and desktop tests separately.'
exit "$failed"
