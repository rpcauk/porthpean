#!/usr/bin/env bash
set +x
set +v
set +a
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo 'Run as root after reviewing this directory.' >&2; exit 1; }
source /etc/os-release
[[ $ID == arch && $(uname -m) == x86_64 ]] || { echo 'Arch x86_64 only'; exit 1; }
[[ $# == 0 ]] || { echo 'Usage: bash bootstrap (interactive)'; exit 1; }
[[ -t 0 && -t 1 ]] || { echo 'Run interactively, not piped from curl.'; exit 1; }
base=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
command -v whiptail >/dev/null || { echo 'Install the dialog dependency first: pacman -Syu --needed libnewt'; exit 1; }
source "$base/ui.sh"
source "$base/permissions.sh"
umask 022
export LANG=C.UTF-8 LC_ALL=C.UTF-8
[[ $(locale charmap) == UTF-8 ]] || { echo "A UTF-8 locale is required." >&2; exit 1; }
progress_dir=$(mktemp -d /root/porthpean-progress.XXXXXXXX)
install_log="$progress_dir/install.log"
: > "$install_log"
chmod 0600 "$install_log"
progress_helper="$base/progress.py"
trap 'status=$?; if [[ $status != 0 ]]; then whiptail --title "Setup stopped - log" --scrolltext --textbox "$install_log" 22 78 >/dev/tty 2>&1 || true; fi' EXIT
if ! daily_user=$(ui_input 'Daily account' 'Choose your daily username:' ryan); then ui_cancel; fi
[[ ${#daily_user} -le 32 && $daily_user =~ ^[a-z][a-z0-9_-]*$ ]] || { echo 'Invalid username'; exit 1; }
[[ $daily_user != root && $daily_user != codex && $daily_user != amp ]] || { echo 'Reserved account name'; exit 1; }
existing=false
if getent passwd "$daily_user" >/dev/null; then
  existing=true
  [[ $(id -u "$daily_user") -ge 1000 && $(getent passwd "$daily_user" | cut -d: -f6) == "/home/$daily_user" ]] || { echo 'Refusing to manage a system account or unexpected home'; exit 1; }
  for group in $(id -nG "$daily_user"); do
    case "$group" in disk|docker|input) echo "Remove privileged group $group deliberately before continuing"; exit 1 ;; esac
  done
  echo "Existing account $daily_user: home permissions and managed desktop files will be updated, with file backups."
fi
agents=()
if ! selected=$(whiptail --backtitle 'Porthpean workstation' --title 'AI accounts' --output-fd 3 \
  --separate-output --checklist 'Create dedicated accounts for:' 14 72 4 \
  codex 'Codex CLI' ON amp 'Amp CLI' ON 3>&1 1>&2); then ui_cancel; fi
while IFS= read -r agent; do
  [[ -n $agent ]] || continue
  [[ $agent == codex || $agent == amp ]] || exit 1
  agents+=("$agent")
done <<< "$selected"
for agent in "${agents[@]}"; do
  if getent passwd "$agent" >/dev/null; then
    [[ $(id -u "$agent") -ge 1000 && $(getent passwd "$agent" | cut -d: -f6) == "/home/$agent" ]] || { echo "Unexpected existing account $agent"; exit 1; }
    echo "Existing $agent account: will enforce locked password and no supplementary groups."
  fi
done
if ! ui_yesno 'Set up workstation' "Daily account: $daily_user\nAI accounts: ${agents[*]:-(none)}\n\nInstall yay/AUR packages, Zsh, Thunderbird, Citrix and Zoom 6.4.11, desktop and boot/unlock theme?\n\nThe daily account gets password-protected sudo for pacman and power controls. Agent accounts get no sudo."; then ui_cancel; fi
# Secrets stay briefly in non-exported local variables and go to chpasswd over stdin.
if [[ $existing == false ]]; then
  useradd -m -U -s /bin/bash "$daily_user"
  chmod 700 "/home/$daily_user"
  if ! ui_set_account_password "$daily_user"; then ui_cancel; fi
else
  status=$(passwd -S "$daily_user" | awk '{print $2}')
  if [[ $status != P ]]; then
    echo 'A usable daily-account password must be set.'
    if ! ui_set_account_password "$daily_user"; then ui_cancel; fi
  else
    if ui_yesno 'Account password' 'Change the existing daily-account password?'; then
      if ! ui_set_account_password "$daily_user"; then ui_cancel; fi
    fi
  fi
fi
# Repair known directories left restrictive by early base installers; never recurse.
repair_system_permissions /
runuser -u alpm -- test -x /var/cache/pacman/pkg
# AUR builds open both installed and repository metadata without root privileges.
runuser -u "$daily_user" -- pacman -Q >/dev/null
runuser -u "$daily_user" -- pacman -Sl >/dev/null
run_progress 'Upgrading the installed system' pacman -Syu --noconfirm
# An upgraded kernel cannot load modules removed with its old package version.
if [[ ! -s /usr/lib/modules/$(uname -r)/modules.dep ]]; then
  if ui_yesno 'Reboot required after kernel upgrade' 'The running kernel no longer has matching modules. Reboot, log in as root and rerun /root/install.sh to continue setup. Reboot now?'; then reboot; fi
  exit 0
fi
run_progress 'Installing setup tools' bash "$base/install-packages" python ansible-core
package_lines=$(python3 -c 'import sys,yaml; print("\n".join(yaml.safe_load(open(sys.argv[1]))[0]["vars"]["packages"]))' "$base/site.yml")
mapfile -t packages <<< "$package_lines"
[[ ${#packages[@]} -gt 0 ]] || exit 1
run_progress 'Installing desktop packages' bash "$base/install-packages" "${packages[@]}"
# Check kernel support before asking nft to validate rules; do not skip validation.
run_progress 'Checking firewall kernel support' modprobe nf_tables
# Only names/options are passed; no passwords, hashes or vendor credentials.
vars=$(python -c 'import json,sys; print(json.dumps({"daily_user":sys.argv[1], "agent_users":sys.argv[2:]}))' "$daily_user" "${agents[@]}")
export PORTHPEAN_DAILY_USER="$daily_user"
for stage in accounts aur shell desktop services validate; do
  case "$stage" in
    accounts) label='Configuring accounts and daily sudo permissions' ;;
    aur)
      run_progress 'Installing yay and AUR shell packages' bash "$base/setup-yay"
      continue ;;
    shell) label='Configuring Zsh, tmux and separate shell histories' ;;
    desktop) label='Configuring the daily desktop' ;;
    services) label='Configuring login, swap and firewall' ;;
    validate) label='Checking desktop and firewall configuration' ;;
    activate) label='Enabling verified services for next boot' ;;
    finalize) label='Recording completed setup' ;;
  esac
  run_progress "$label" ansible-playbook -i localhost, -c local "$base/site.yml" \
    --tags "$stage" -e "@$base/profiles/t480s.yml" -e "$vars" -e packages_preinstalled=true
done
# These steps have their own logs/progress; no package code is built as root.
export progress_helper install_log
run_progress 'Applying matching boot and unlock appearance' bash "$base/setup-appearance"
PORTHPEAN_DAILY_USER="$daily_user" bash "$base/install-citrix"
run_progress 'Installing Zoom Citrix plugin 6.4.11 (26350)' bash "$base/install-zoom"
for stage in activate finalize; do
  run_progress "Finishing workstation: $stage" ansible-playbook -i localhost, -c local "$base/site.yml" \
    --tags "$stage" -e "@$base/profiles/t480s.yml" -e "$vars" -e packages_preinstalled=true
done
if ui_yesno 'Workstation ready' "Configuration applied. Log in as $daily_user after reboot.\n\nReboot now?"; then reboot; fi
