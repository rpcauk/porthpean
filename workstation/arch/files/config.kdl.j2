input {
    keyboard { xkb { layout "{{ xkb_layout }}"; }; };
    touchpad { tap; natural-scroll; };
}
prefer-no-csd
layout {
    gaps 8
    background-color "#1e1e1e"
    focus-ring {
        width 1
        active-color "#007acc"
        inactive-color "#3c3c3c"
    }
    border { off; }
}
animations { off; }
spawn-at-startup "swaybg" "-i" "/usr/share/backgrounds/porthpean/diogenes.jpg" "-m" "fill"
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "swayidle" "-w" "timeout" "300" "porthpean-lock" "before-sleep" "porthpean-lock --wait"
binds {
    Mod+F1 hotkey-overlay-title="Shortcut map" { show-hotkey-overlay; }
    Mod+Return hotkey-overlay-title="Terminal" { spawn "foot"; }
    Mod+D hotkey-overlay-title="Application launcher" { spawn "tofi-drun"; }
    Mod+Space hotkey-overlay-title="Application launcher" { spawn "tofi-drun"; }
    Mod+B hotkey-overlay-title="LibreWolf" { spawn "librewolf"; }
    Mod+E hotkey-overlay-title="Thunderbird" { spawn "thunderbird"; }
    Mod+G hotkey-overlay-title="ChatGPT" { spawn "librewolf" "https://chatgpt.com/"; }
    Mod+C hotkey-overlay-title="Codex terminal" { spawn "porthpean-agent" "codex"; }
    Mod+A hotkey-overlay-title="Amp terminal" { spawn "porthpean-agent" "amp"; }
    Mod+Shift+C hotkey-overlay-title="Codex web" { spawn "librewolf" "https://chatgpt.com/codex"; }
    Mod+Shift+A hotkey-overlay-title="Amp web" { spawn "librewolf" "https://ampcode.com/"; }
    Mod+W hotkey-overlay-title="Citrix Workspace" { spawn "porthpean-citrix"; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }
    Mod+Shift+L hotkey-overlay-title="Lock screen" { spawn "porthpean-lock"; }
    Mod+Q { close-window; }
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+Semicolon { focus-column-right; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+Semicolon { move-column-right; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+Shift+E { quit; }
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "5%-"; }
}
