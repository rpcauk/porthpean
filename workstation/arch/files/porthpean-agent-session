#!/usr/bin/env bash
set -euo pipefail
agent=$(id -un)
case "$agent" in codex|amp) ;; *) exit 1 ;; esac
export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$PATH"
if command -v "$agent" >/dev/null; then
  exec tmux new-session -A -s "$agent" "$agent"
fi
printf '%s CLI is not installed yet. Run porthpean-install-agent here, then authenticate as this account.\n' "$agent"
exec bash -l
