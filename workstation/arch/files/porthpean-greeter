#!/usr/bin/env python3
"""A small GTK login surface; greetd/PAM performs all authentication."""
import datetime
import json
import os
import socket
import struct
import subprocess
import sys
import threading


class LoginError(Exception):
    pass


class GreetdClient:
    def __init__(self, connection):
        self.connection = connection

    def receive(self, length):
        parts = bytearray()
        while len(parts) < length:
            chunk = self.connection.recv(length - len(parts))
            if not chunk:
                raise LoginError('Login service disconnected.')
            parts.extend(chunk)
        return bytes(parts)

    def request(self, message):
        payload = json.dumps(message).encode('utf-8')
        self.connection.sendall(struct.pack('=I', len(payload)) + payload)
        length, = struct.unpack('=I', self.receive(4))
        if not 0 < length <= 1024 * 1024:
            raise LoginError('Invalid login service response.')
        reply = json.loads(self.receive(length))
        if reply.get('type') == 'error':
            if reply.get('error_type') == 'auth_error':
                raise LoginError('Authentication failed. Try again.')
            raise LoginError('Login service could not start the session.')
        return reply

    def cancel(self):
        try:
            self.request({'type': 'cancel_session'})
        except (OSError, LoginError, ValueError):
            pass
        finally:
            self.connection.close()


class Conversation:
    """Handle repeated PAM prompts, including visible questions and OTPs."""
    def __init__(self, client):
        self.client = client

    def start(self, username, first_secret):
        return self.advance(self.client.request({'type': 'create_session', 'username': username}), first_secret)

    def answer(self, value):
        return self.advance(self.client.request({'type': 'post_auth_message_response', 'response': value}))

    def advance(self, reply, first_secret=None):
        notices = []
        for _ in range(64):
            kind = reply.get('type')
            if kind == 'success':
                result = self.client.request({'type': 'start_session', 'cmd': ['/usr/bin/niri-session'],
                    'env': ['XDG_SESSION_TYPE=wayland', 'XDG_CURRENT_DESKTOP=niri', 'XDG_SESSION_DESKTOP=niri']})
                if result.get('type') != 'success':
                    raise LoginError('Login service could not start the session.')
                return 'started', '', ''
            if kind != 'auth_message':
                raise LoginError('Unexpected login service response.')
            mode = reply.get('auth_message_type')
            prompt = reply.get('auth_message', '')
            if mode == 'secret' and first_secret is not None:
                response, first_secret = first_secret, None
            elif mode in ('secret', 'visible'):
                return mode, prompt, '\n'.join(notices)
            elif mode in ('info', 'error'):
                notices.append(prompt)
                response = None
            else:
                raise LoginError('Unsupported authentication prompt.')
            reply = self.client.request({'type': 'post_auth_message_response', 'response': response})
            response = None
        raise LoginError('Too many authentication messages.')


def main():
    # Import GTK only in the graphical entry point; protocol tests need no display.
    import gi
    gi.require_version('Gtk', '4.0')
    from gi.repository import Gdk, GLib, Gtk

    class Greeter(Gtk.Application):
        def __init__(self):
            super().__init__(application_id='uk.rpca.porthpean.greeter')
            self.conversation = None
            self.busy = False

        def do_activate(self):
            window = Gtk.ApplicationWindow(application=self, title='Login')
            window.set_decorated(False)
            window.fullscreen()
            provider = Gtk.CssProvider()
            provider.load_from_path('/etc/greetd/login.css')
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            overlay = Gtk.Overlay()
            window.set_child(overlay)
            panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                            halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
            panel.set_size_request(360, -1)
            overlay.set_child(panel)
            self.clock = Gtk.Label(css_classes=['clock'])
            self.date = Gtk.Label(css_classes=['date'])
            panel.append(self.clock)
            panel.append(self.date)
            self.user = Gtk.Entry(text=sys.argv[1] if len(sys.argv) == 2 else '', placeholder_text='User')
            self.user.set_alignment(0.5)
            self.user.add_css_class('username')
            self.user.set_margin_top(32)
            panel.append(self.user)
            self.password = Gtk.Entry(visibility=False, placeholder_text='Password')
            self.password.set_alignment(0.5)
            self.password.set_input_purpose(Gtk.InputPurpose.PASSWORD)
            self.password.connect('activate', self.submit)
            self.user.connect('activate', lambda *_: self.password.grab_focus())
            panel.append(self.password)
            self.message = Gtk.Label(wrap=True, max_width_chars=44, css_classes=['message'])
            panel.append(self.message)
            self.login = Gtk.Button(label='Log in')
            self.login.connect('clicked', self.submit)
            panel.append(self.login)
            power = Gtk.Box(spacing=16, halign=Gtk.Align.CENTER, valign=Gtk.Align.END, margin_bottom=32)
            for label, action in [('Reboot', 'reboot'), ('Shutdown', 'poweroff')]:
                button = Gtk.Button(label=label)
                button.connect('clicked', self.power_action, action)
                power.append(button)
            overlay.add_overlay(power)
            self.tick()
            GLib.timeout_add_seconds(1, self.tick)
            window.present()
            self.password.grab_focus()

        def tick(self):
            now = datetime.datetime.now().astimezone()
            self.clock.set_text(now.strftime('%H:%M'))
            self.date.set_text(now.strftime('%A, %d %B %Y'))
            return True

        def power_action(self, _button, action):
            if not self.busy:
                subprocess.Popen(['/usr/bin/systemctl', action])

        def submit(self, *_):
            if self.busy:
                return
            username = self.user.get_text().strip()
            if not username:
                self.user.grab_focus()
                return
            answer = self.password.get_text()
            self.password.set_text('')
            self.busy = True
            self.user.set_sensitive(False)
            self.password.set_sensitive(False)
            self.login.set_sensitive(False)
            self.message.set_text('Authenticating…')
            threading.Thread(target=self.authenticate, args=(username, answer), daemon=True).start()

        def authenticate(self, username, answer):
            try:
                if self.conversation is None:
                    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    connection.settimeout(30)
                    try:
                        connection.connect(os.environ['GREETD_SOCK'])
                    except Exception:
                        connection.close()
                        raise
                    self.conversation = Conversation(GreetdClient(connection))
                    result = self.conversation.start(username, answer)
                else:
                    result = self.conversation.answer(answer)
                GLib.idle_add(self.completed, result, None)
            except Exception as error:
                if self.conversation is not None:
                    self.conversation.client.cancel()
                    self.conversation = None
                # Never log replies, passwords, environment or exception payloads.
                message = str(error) if isinstance(error, LoginError) else 'Login service unavailable. Try again.'
                GLib.idle_add(self.completed, None, message)
            finally:
                answer = None

        def completed(self, result, error):
            self.busy = False
            if error:
                self.message.set_text(error)
                self.user.set_sensitive(True)
                self.password.set_visibility(False)
                self.password.set_placeholder_text('Password')
            elif result[0] == 'started':
                self.quit()  # greetd starts the authenticated session after we exit.
                return False
            else:
                mode, prompt, notices = result
                self.password.set_visibility(mode == 'visible')
                self.password.set_placeholder_text(prompt.strip() or 'Password')
                self.message.set_text(notices)
            self.password.set_sensitive(True)
            self.login.set_sensitive(True)
            self.password.grab_focus()
            return False

    app = Greeter()
    return app.run([sys.argv[0]])


if __name__ == '__main__':
    raise SystemExit(main())
